{
  "schemaVersion": 1,
  "workflow": {
    "enabled": true
  },
  "git": {
    "sync": {
      "mode": "update",
      "updateMethod": "ffOnly"
    },
    "backup": {
      "mode": "all",
      "method": "stash"
    },
    "commit": {
      "mode": "autoCommitAndPush"
    },
    "branch": {
      "baseBranches": [
        "main"
      ],
      "deleteAfterIntegration": false
    },
    "integration": {
      "mode": "pullRequest",
      "mergeMethod": "mergeCommit"
    }
  }
}
