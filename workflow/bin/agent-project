#!/usr/bin/env python3

import json
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from agent_project.schema import (
    ALLOWED_VALUES, DEFAULT_SETTINGS, SCHEMA, SCHEMA_TYPE_NAMES, SCHEMA_VERSION,
    configurable_paths, configurable_type, get_value, leaf_paths, parse_value,
    project_schema, reset_to_default, schema_type, set_setting, validate_structure,
    validate_values,
)
from agent_project.storage import config_path, load_settings, write_settings


def print_value(value):
    if isinstance(value, bool):
        print("true" if value else "false")
    elif isinstance(value, (dict, list)):
        print(json.dumps(value, separators=(",", ":")))
    else:
        print(value)


def usage(file=sys.stderr):
    print(
        "Usage:\n"
        "  agent-project schema [path]\n"
        "  agent-project effective\n"
        "  agent-project get <path>\n"
        "  agent-project set <path> <value> [<path> <value> ...]\n"
        "  agent-project unset <path> [<path> ...]\n"
        "\n"
        "Commands:\n"
        "  schema     Show settings, types, defaults, allowed values, and constraints.\n"
        "             Optionally inspect one setting by path.\n"
        "  effective  Show the complete configuration for the current repository.\n"
        "  get        Show one current setting value.\n"
        "  set        Set one or more values atomically. If absent, create a complete\n"
        "             .ai/project.json from defaults.\n"
        "  unset      Reset one or more values to current built-in defaults.\n"
        "             Existing fields remain explicitly present in project.json.",
        file=file,
    )


def main():
    if len(sys.argv) == 2 and sys.argv[1] in {"-h", "--help"}:
        usage(sys.stdout)
        return

    if len(sys.argv) == 2 and sys.argv[1] == "effective":
        print(json.dumps(load_settings(), indent=2))
        return

    if len(sys.argv) == 3 and sys.argv[1] == "get":
        configurable_type(sys.argv[2])
        print_value(get_value(load_settings(), sys.argv[2]))
        return

    if sys.argv[1:2] == ["schema"] and len(sys.argv) in {2, 3}:
        config_path()
        setting_path = sys.argv[2] if len(sys.argv) == 3 else None
        print(json.dumps(project_schema(setting_path), separators=(",", ":")))
        return

    if sys.argv[1:2] == ["set"] and len(sys.argv) >= 4 and len(sys.argv[2:]) % 2 == 0:
        pairs = list(zip(sys.argv[2::2], sys.argv[3::2]))
        parsed_values = [(path, parse_value(path, raw_value))
                         for path, raw_value in pairs]
        settings = load_settings()
        for path, value in parsed_values:
            set_setting(settings, path, value)
        validate_structure(settings, SCHEMA)
        validate_values(settings)
        write_settings(settings)
        if len(pairs) == 1:
            print(f"[project] set ok path={pairs[0][0]}")
        else:
            print(f"[project] set ok count={len(pairs)}")
        return

    if sys.argv[1:2] == ["unset"] and len(sys.argv) >= 3:
        paths = sys.argv[2:]
        for path in paths:
            configurable_type(path)
        settings = load_settings()
        changed_count = sum(reset_to_default(settings, path) for path in paths)
        validate_structure(settings, SCHEMA)
        validate_values(settings)
        if changed_count or config_path().exists():
            write_settings(settings)
        if len(paths) == 1:
            path = paths[0]
            print(f"[project] unset {'ok' if changed_count else 'skip'} path={path}"
                  + ("" if changed_count else " reason=already-default"))
        else:
            print(f"[project] unset ok count={changed_count}")
        return

    usage()
    raise SystemExit(1)


if __name__ == "__main__":
    main()
