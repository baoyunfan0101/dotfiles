#!/usr/bin/env python3

import json
import os
import subprocess
import sys
import tempfile
from copy import deepcopy
from pathlib import Path


SCHEMA_VERSION = 1

DEFAULT_SETTINGS = {
    "schemaVersion": SCHEMA_VERSION,
    "workflow": {
        "enabled": False,
    },
    "git": {
        "sync": {
            "mode": "update",
            "updateMethod": "ffOnly",
        },
        "backup": {
            "mode": "all",
            "method": "stash",
        },
        "commit": {
            "mode": "automatic",
        },
        "branch": {
            "mode": "fromBase",
            "baseBranches": ["main"],
            "deleteAfterIntegration": False,
        },
        "integration": {
            "mode": "localMerge",
            "mergeMethod": "mergeCommit",
        },
    },
}

SCHEMA = {
    "schemaVersion": int,
    "workflow": {
        "enabled": bool,
    },
    "git": {
        "sync": {
            "mode": str,
            "updateMethod": str,
        },
        "backup": {
            "mode": str,
            "method": str,
        },
        "commit": {
            "mode": str,
        },
        "branch": {
            "mode": str,
            "baseBranches": list,
            "deleteAfterIntegration": bool,
        },
        "integration": {
            "mode": str,
            "mergeMethod": str,
        },
    },
}

ALLOWED_VALUES = {
    "git.sync.mode": {"none", "fetch", "update"},
    "git.sync.updateMethod": {"ffOnly", "rebase", "merge"},
    "git.backup.mode": {"none", "tracked", "untracked", "all"},
    "git.backup.method": {"stash", "commit"},
    "git.commit.mode": {"manual", "automatic"},
    "git.branch.mode": {"current", "alwaysCreate", "fromBase"},
    "git.integration.mode": {"localMerge", "pullRequest"},
    "git.integration.mergeMethod": {"squash", "mergeCommit"},
}


def fail(message):
    print(f"agent-project: {message}", file=sys.stderr)
    raise SystemExit(1)


def find_project_root():
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
        )
    except OSError as error:
        fail(f"cannot run git: {error}")

    if result.returncode == 0:
        return Path(result.stdout.strip())

    fail("current directory is not inside a Git worktree")


def config_path():
    return find_project_root() / ".ai" / "project.json"


def merge_settings(defaults, overrides):
    result = deepcopy(defaults)

    for key, value in overrides.items():
        if isinstance(value, dict) and isinstance(result.get(key), dict):
            result[key] = merge_settings(result[key], value)
        else:
            result[key] = value

    return result


def validate_structure(value, schema, path=""):
    if not isinstance(value, dict):
        fail(f"{path or 'root'} must be an object")

    unknown_keys = set(value) - set(schema)

    if unknown_keys:
        key = sorted(unknown_keys)[0]
        full_path = f"{path}.{key}" if path else key
        fail(f"unknown setting: {full_path}")

    for key, item in value.items():
        expected = schema[key]
        current_path = f"{path}.{key}" if path else key

        if isinstance(expected, dict):
            validate_structure(item, expected, current_path)
        elif type(item) is not expected:
            fail(f"{current_path} has an invalid type")


def schema_type(path):
    value = SCHEMA

    for key in path.split("."):
        if not isinstance(value, dict) or key not in value:
            fail(f"unknown setting: {path}")
        value = value[key]

    if isinstance(value, dict):
        fail(f"setting path must identify a value: {path}")

    return value


def get_value(settings, path):
    value = settings

    for key in path.split("."):
        if not isinstance(value, dict) or key not in value:
            fail(f"unknown setting: {path}")
        value = value[key]

    return value


def validate_values(settings):
    if settings["schemaVersion"] != SCHEMA_VERSION:
        fail(f"unsupported schemaVersion: {settings['schemaVersion']}")

    for path, allowed_values in ALLOWED_VALUES.items():
        value = get_value(settings, path)

        if value not in allowed_values:
            allowed = ", ".join(sorted(allowed_values))
            fail(f"{path} must be one of: {allowed}")

    base_branches = settings["git"]["branch"]["baseBranches"]

    if not all(isinstance(branch, str) and branch for branch in base_branches):
        fail("git.branch.baseBranches must contain non-empty strings")

    if len(base_branches) != len(set(base_branches)):
        fail("git.branch.baseBranches must not contain duplicates")

    if (
        settings["git"]["branch"]["mode"] == "fromBase"
        and not base_branches
    ):
        fail(
            "git.branch.baseBranches must not be empty "
            "when git.branch.mode is fromBase"
        )


def load_overrides():
    path = config_path()

    if not path.exists():
        return {"schemaVersion": SCHEMA_VERSION}

    try:
        with path.open(encoding="utf-8") as file:
            overrides = json.load(file)
    except json.JSONDecodeError as error:
        fail(f"invalid JSON in {path}: {error}")
    except OSError as error:
        fail(f"cannot read {path}: {error}")

    validate_structure(overrides, SCHEMA)

    if "schemaVersion" not in overrides:
        fail("schemaVersion is required")

    if overrides["schemaVersion"] != SCHEMA_VERSION:
        fail(f"unsupported schemaVersion: {overrides['schemaVersion']}")

    return overrides


def effective_settings(overrides):
    settings = merge_settings(DEFAULT_SETTINGS, overrides)
    validate_values(settings)
    return settings


def parse_value(path, raw_value):
    expected = schema_type(path)

    if expected is str:
        value = raw_value
    elif expected is bool:
        if raw_value == "true":
            value = True
        elif raw_value == "false":
            value = False
        else:
            fail(f"{path} must be true or false")
    elif expected is int:
        try:
            value = int(raw_value)
        except ValueError:
            fail(f"{path} must be an integer")
    else:
        try:
            value = json.loads(raw_value)
        except json.JSONDecodeError as error:
            fail(f"{path} must be valid JSON: {error.msg}")
        if not isinstance(value, expected):
            fail(f"{path} has an invalid type")

    return value


def set_override(overrides, path, value):
    keys = path.split(".")
    current = overrides

    for key in keys[:-1]:
        current = current.setdefault(key, {})
        if not isinstance(current, dict):
            fail(f"cannot set nested value under {key}")

    current[keys[-1]] = value


def unset_override(overrides, path):
    if path == "schemaVersion":
        fail("schemaVersion cannot be unset")

    keys = path.split(".")
    current = overrides
    parents = []

    for key in keys[:-1]:
        if not isinstance(current, dict) or key not in current:
            return False
        parents.append((current, key))
        current = current[key]

    if not isinstance(current, dict) or keys[-1] not in current:
        return False

    del current[keys[-1]]

    for parent, key in reversed(parents):
        child = parent[key]
        if isinstance(child, dict) and not child:
            del parent[key]
        else:
            break

    return True


def write_overrides(overrides):
    path = config_path()

    temporary = None
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=path.parent,
            prefix=".project.json.",
            delete=False,
        ) as file:
            temporary = Path(file.name)
            json.dump(overrides, file, indent=2)
            file.write("\n")
        os.replace(temporary, path)
    except OSError as error:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
        fail(f"cannot write {path}: {error}")


def print_value(value):
    if isinstance(value, bool):
        print("true" if value else "false")
    elif isinstance(value, (dict, list)):
        print(json.dumps(value, separators=(",", ":")))
    else:
        print(value)


def usage(file=sys.stderr):
    print(
        "Usage:\n"
        "  agent-project effective\n"
        "  agent-project get <path>\n"
        "  agent-project set <path> <value>\n"
        "  agent-project unset <path>",
        file=file,
    )


def main():
    if len(sys.argv) == 2 and sys.argv[1] in {"-h", "--help"}:
        usage(sys.stdout)
        return

    if len(sys.argv) == 2 and sys.argv[1] == "effective":
        print(json.dumps(effective_settings(load_overrides()), indent=2))
        return

    if len(sys.argv) == 3 and sys.argv[1] == "get":
        print_value(get_value(effective_settings(load_overrides()), sys.argv[2]))
        return

    if len(sys.argv) == 4 and sys.argv[1] == "set":
        path = sys.argv[2]
        value = parse_value(path, sys.argv[3])
        overrides = load_overrides()
        set_override(overrides, path, value)
        validate_structure(overrides, SCHEMA)
        effective_settings(overrides)
        write_overrides(overrides)
        print(f"[project] set ok path={path}")
        return

    if len(sys.argv) == 3 and sys.argv[1] == "unset":
        path = sys.argv[2]
        schema_type(path)
        overrides = load_overrides()
        changed = unset_override(overrides, path)
        effective_settings(overrides)
        if changed or config_path().exists():
            write_overrides(overrides)
        print(
            f"[project] unset {'ok' if changed else 'skip'} path={path}"
            + ("" if changed else " reason=not-overridden")
        )
        return

    usage()
    raise SystemExit(1)


if __name__ == "__main__":
    main()
