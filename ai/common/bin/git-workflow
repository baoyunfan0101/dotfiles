#!/usr/bin/env bash
set -Eeuo pipefail

WORKFLOW_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$WORKFLOW_SOURCE" ]]; do
  WORKFLOW_DIR="$(cd -P "$(dirname "$WORKFLOW_SOURCE")" && pwd)"
  WORKFLOW_SOURCE="$(readlink "$WORKFLOW_SOURCE")"
  [[ "$WORKFLOW_SOURCE" == /* ]] || WORKFLOW_SOURCE="$WORKFLOW_DIR/$WORKFLOW_SOURCE"
done
WORKFLOW_ROOT="$(cd -P "$(dirname "$WORKFLOW_SOURCE")/.." && pwd)"

case "${1:-}" in
  start|commit|finish|push)
    action="$1"
    shift
    exec "$WORKFLOW_ROOT/libexec/git-workflow/$action" "$@"
    ;;
  *)
    source "$WORKFLOW_ROOT/lib/git-workflow/runtime.sh"
    case "${1:-}" in
      -h|--help) usage ;;
      "") usage >&2; exit 1 ;;
      *) fail "unknown command: $1" ;;
    esac
    ;;
esac
