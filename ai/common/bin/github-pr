#!/usr/bin/env bash
set -Eeuo pipefail

CURRENT_ACTION="pr"

usage() {
  cat <<'EOF'
Usage:
  github-pr auto-merge [--branch BRANCH]
  github-pr status [--branch BRANCH]

Commands:
  auto-merge
      Enable GitHub auto-merge for the existing pull request when configured.

  status
      Emit a compact pull-request state for the selected branch.
EOF
}

fail() {
  printf '[pr] %s error reason="%s"\n' "$CURRENT_ACTION" "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

setting() {
  agent-project-settings get "$1"
}

selected_branch() {
  local branch="$1"

  if [[ -n "$branch" ]]; then
    printf '%s\n' "$branch"
    return 0
  fi

  branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  [[ -n "$branch" ]] || fail "cannot determine branch"
  printf '%s\n' "$branch"
}

auto_merge() {
  CURRENT_ACTION="auto-merge"
  local branch=""
  local enabled
  local merge_method
  local url

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --branch)
        [[ $# -ge 2 ]] || fail "missing value for --branch"
        branch="$2"
        shift 2
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        fail "unknown option: $1"
        ;;
    esac
  done

  require_command git
  require_command gh
  require_command agent-project-settings

  enabled="$(setting git.integration.pullRequest.autoMerge)"
  if [[ "$enabled" != "true" ]]; then
    printf '[pr] auto-merge skip reason=disabled\n'
    return 0
  fi

  branch="$(selected_branch "$branch")"
  merge_method="$(setting git.integration.pullRequest.mergeMethod)"
  gh auth status >/dev/null 2>&1 || fail "GitHub CLI is not authenticated"

  url="$(gh pr view "$branch" --json url --jq '.url' 2>/dev/null || true)"
  [[ -n "$url" ]] || fail "pull request not found for branch: $branch"

  case "$merge_method" in
    merge)
      gh pr merge "$branch" --auto --merge >/dev/null
      ;;
    squash)
      gh pr merge "$branch" --auto --squash >/dev/null
      ;;
    rebase)
      gh pr merge "$branch" --auto --rebase >/dev/null
      ;;
    *)
      fail "unsupported pull request merge method: $merge_method"
      ;;
  esac

  printf '[pr] auto-merge ok branch=%s method=%s url=%s\n' \
    "$branch" "$merge_method" "$url"
}

status() {
  CURRENT_ACTION="status"
  local branch=""
  local result

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --branch)
        [[ $# -ge 2 ]] || fail "missing value for --branch"
        branch="$2"
        shift 2
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        fail "unknown option: $1"
        ;;
    esac
  done

  require_command git
  require_command gh

  branch="$(selected_branch "$branch")"
  result="$(gh pr view "$branch" --json number,url,state,mergeStateStatus,isDraft --jq '[.number,.state,.mergeStateStatus,.isDraft,.url] | @tsv' 2>/dev/null || true)"
  [[ -n "$result" ]] || fail "pull request not found for branch: $branch"

  IFS=$'\t' read -r number state merge_state draft url <<< "$result"
  printf '[pr] status ok number=%s state=%s mergeState=%s draft=%s url=%s\n' \
    "$number" "$state" "$merge_state" "$draft" "$url"
}

main() {
  [[ $# -gt 0 ]] || { usage >&2; exit 1; }

  case "$1" in
    auto-merge)
      shift
      auto_merge "$@"
      ;;
    status)
      shift
      status "$@"
      ;;
    -h|--help)
      usage
      ;;
    *)
      fail "unknown command: $1"
      ;;
  esac
}

main "$@"
