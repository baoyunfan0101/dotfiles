#!/usr/bin/env bash
set -Eeuo pipefail

WORKFLOW_ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source "$WORKFLOW_ROOT/lib/git-workflow/runtime.sh"
source "$WORKFLOW_ROOT/lib/git-workflow/backup.sh"
source "$WORKFLOW_ROOT/lib/git-workflow/sync.sh"
source "$WORKFLOW_ROOT/lib/git-workflow/branch.sh"

PREPARE_BASE=""
PREPARE_CONTINUE=false
PREPARE_BASE_SET=false
PREPARE_BRANCH_NAME_SET=false

parse_prepare_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --continue)
        [[ "$PREPARE_CONTINUE" == false ]] || fail "duplicate --continue"
        PREPARE_CONTINUE=true
        shift
        ;;
      --branch-name)
        [[ $# -ge 2 ]] || fail "missing value for --branch-name"
        [[ "$PREPARE_BRANCH_NAME_SET" == false ]] || fail "duplicate --branch-name"
        PREPARE_BRANCH_NAME_SET=true
        BRANCH_NAME="$2"
        shift 2
        ;;
      --branch-name=*)
        [[ "$PREPARE_BRANCH_NAME_SET" == false ]] || fail "duplicate --branch-name"
        PREPARE_BRANCH_NAME_SET=true
        BRANCH_NAME="${1#*=}"
        shift
        ;;
      --base)
        [[ $# -ge 2 && -n "$2" ]] || fail "missing value for --base"
        [[ "$PREPARE_BASE_SET" == false ]] || fail "duplicate --base"
        PREPARE_BASE_SET=true
        PREPARE_BASE="$2"
        shift 2
        ;;
      --base=*)
        [[ "$PREPARE_BASE_SET" == false ]] || fail "duplicate --base"
        PREPARE_BASE_SET=true
        PREPARE_BASE="${1#*=}"
        [[ -n "$PREPARE_BASE" ]] || fail "missing value for --base"
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        fail "unknown option: $1"
        ;;
    esac
  done

  if [[ "$PREPARE_CONTINUE" == true ]] &&
      { [[ "$PREPARE_BASE_SET" == true ]] || [[ "$PREPARE_BRANCH_NAME_SET" == true ]]; }; then
    fail "--continue cannot be combined with --base or --branch-name"
  fi
  if [[ "$PREPARE_CONTINUE" != true ]]; then
    [[ "$PREPARE_BASE_SET" == true ]] || fail "new work requires --base and --branch-name"
    [[ "$PREPARE_BRANCH_NAME_SET" == true ]] || fail "--base requires --branch-name"
    [[ -n "$BRANCH_NAME" ]] || fail "--branch-name is required"
  fi
}

prepare_failure() {
  if [[ "$BACKUP_CREATED" == true ]]; then
    fail "$1; backup retained id=$(backup_id "$BACKUP_SHA")"
  fi
  fail "$1"
}

restore_failed_base_entry() {
  local original_branch="$1"
  local base_branch="$2"
  local base_head="$3"
  local created_branch="$4"
  local reason="$5"

  if [[ -n "$created_branch" ]]; then
    if [[ "$(current_branch)" == "$created_branch" ]]; then
      git checkout -q "$base_branch" || prepare_failure "$reason; could not return to base"
    fi
    git branch -D "$created_branch" >/dev/null || prepare_failure "$reason; could not remove incomplete branch"
  fi
  if [[ "$(current_branch)" == "$base_branch" && "$(git rev-parse HEAD)" != "$base_head" ]]; then
    git reset --keep --quiet "$base_head" || prepare_failure "$reason; could not restore base HEAD"
  fi
  if [[ "$(current_branch)" != "$original_branch" ]]; then
    git checkout -q "$original_branch" || prepare_failure "$reason; could not restore original branch"
  fi
  prepare_failure "$reason; original branch was restored"
}

prepare_from_base() {
  local original_branch="$1"
  local base_head
  local base_ref
  local base_remote
  local created_branch=""

  is_base_branch "$PREPARE_BASE" || fail "base is not configured in git.branch.baseBranches: $PREPARE_BASE"
  validate_new_branch "$BRANCH_NAME"
  if is_base_branch "$BRANCH_NAME"; then
    fail "working branch is a configured base branch: $BRANCH_NAME"
  fi
  if [[ "$(git symbolic-ref --quiet HEAD)" == "refs/heads/$PREPARE_BASE" ]] &&
      ! git rev-parse --verify HEAD^{commit} >/dev/null 2>&1 &&
      [[ -z "$(git rev-list --all --max-count=1)" ]]; then
    git symbolic-ref HEAD "refs/heads/$BRANCH_NAME" || fail "branch creation failed: $BRANCH_NAME"
    [[ "$(current_branch)" == "$BRANCH_NAME" ]] || fail "created branch verification failed: $BRANCH_NAME"
    BRANCH_CREATED=true
    return 0
  fi
  git show-ref --verify --quiet "refs/heads/$PREPARE_BASE" || fail "local base branch not found: $PREPARE_BASE"
  base_head="$(git rev-parse "$PREPARE_BASE^{commit}")"

  create_backup
  if ! base_remote="$(remote_for_branch "$PREPARE_BASE")"; then
    restore_failed_base_entry "$original_branch" "$PREPARE_BASE" "$base_head" "" "base remote resolution failed"
  fi
  if ! base_ref="$(fetch_base_for_entry "$PREPARE_BASE" "$base_remote")"; then
    restore_failed_base_entry "$original_branch" "$PREPARE_BASE" "$base_head" "" "base fetch failed"
  fi
  if ! git merge-base --is-ancestor "$base_head" "$base_ref"; then
    restore_failed_base_entry "$original_branch" "$PREPARE_BASE" "$base_head" "" "local base diverged from fetched remote base: $PREPARE_BASE"
  fi
  if ! git checkout -q "$PREPARE_BASE"; then
    restore_failed_base_entry "$original_branch" "$PREPARE_BASE" "$base_head" "" "base checkout failed"
  fi
  if ! advance_base_for_entry "$PREPARE_BASE" "$base_ref"; then
    restore_failed_base_entry "$original_branch" "$PREPARE_BASE" "$base_head" "" "base update failed"
  fi
  if ! branch_checkout_new "$BRANCH_NAME"; then
    if branch_exists_local "$BRANCH_NAME"; then
      created_branch="$BRANCH_NAME"
    fi
    restore_failed_base_entry "$original_branch" "$PREPARE_BASE" "$base_head" "$created_branch" "branch creation failed"
  fi
  BRANCH_CREATED=true
}

print_prepare_result() {
  local backup_result="none"

  if [[ "$BACKUP_CREATED" == true ]]; then
    backup_result="$BACKUP_METHOD"
  fi

  printf '[git] prepare ok backup=%s sync=%s branch=%s created=%s\n' \
    "$backup_result" \
    "$SYNC_RESULT" \
    "$WORKING_BRANCH" \
    "$BRANCH_CREATED"
}

prepare() {
  CURRENT_ACTION="prepare"
  parse_prepare_args "$@"
  preflight_core
  require_repository

  if ! project_workflow_enabled; then
    printf '[git] prepare skip reason=workflow-disabled\n'
    return 0
  fi

  ORIGINAL_BRANCH="$(current_branch)"
  load_prepare_settings

  if [[ "$PREPARE_CONTINUE" == true ]] && is_base_branch "$ORIGINAL_BRANCH"; then
    fail "--continue requires a working branch"
  fi

  if [[ "$PREPARE_CONTINUE" != true ]]; then
    prepare_from_base "$ORIGINAL_BRANCH"
    WORKING_BRANCH="$(current_branch)"
    print_prepare_result
    return 0
  fi

  create_backup
  if ! sync_current_branch "$ORIGINAL_BRANCH"; then
    prepare_failure "sync failed; original branch was retained"
  fi

  WORKING_BRANCH="$(current_branch)"
  print_prepare_result
}

prepare "$@"
