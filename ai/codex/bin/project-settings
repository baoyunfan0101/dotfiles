#!/usr/bin/env bash
set -euo pipefail

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  repo_root="$(git rev-parse --show-toplevel)"
else
  repo_root="$(pwd)"
fi

config="$repo_root/.codex/project.json"
commit_mode="manual"

if [ -f "$config" ]; then
  commit_mode="$(python3 - "$config" <<'PY'
import json
import sys

path = sys.argv[1]

try:
    with open(path, encoding="utf-8") as config_file:
        data = json.load(config_file)
except Exception as exc:
    print(f"invalid project settings: {exc}", file=sys.stderr)
    sys.exit(2)

value = data.get("commitMode", data.get("commit_mode", "manual"))
if not isinstance(value, str):
    print("invalid project settings: commitMode must be a string", file=sys.stderr)
    sys.exit(2)

print(value)
PY
)"
fi

case "$commit_mode" in
  manual|automatic) ;;
  *)
    printf 'invalid project settings: commitMode must be manual or automatic, got %s\n' "$commit_mode" >&2
    exit 2
    ;;
esac

printf 'commit_mode=%s\n' "$commit_mode"
