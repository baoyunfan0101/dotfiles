#!/usr/bin/env bash
set -Eeuo pipefail

WORKFLOW_ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source "$WORKFLOW_ROOT/lib/git-workflow/runtime.sh"
source "$WORKFLOW_ROOT/lib/git-workflow/mutation.sh"

PUSH_OVERRIDE_MANUAL=false
PUSH_REWRITE=false

parse_push_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --override-manual)
        PUSH_OVERRIDE_MANUAL=true
        shift
        ;;
      --rewrite)
        PUSH_REWRITE=true
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        fail "unknown push option: $1"
        ;;
    esac
  done
}

push_changes() {
  CURRENT_ACTION="push"
  local branch
  local remote

  parse_push_args "$@"
  preflight_core
  require_repository

  if ! project_workflow_enabled; then
    printf '[git] push skip reason=workflow-disabled\n'
    return 0
  fi

  load_commit_settings

  case "$COMMIT_MODE" in
    manual)
      if [[ "$PUSH_OVERRIDE_MANUAL" != true ]]; then
        printf '[git] push skip reason=manual\n'
        return 0
      fi
      ;;
    autoCommit|autoCommitAndPush)
      ;;
    *)
      fail "unsupported git.commit.mode: $COMMIT_MODE"
      ;;
  esac

  branch="$(current_branch)"
  if [[ "$PUSH_REWRITE" == true ]]; then
    require_working_branch "$branch"
    remote="$(remote_for_branch "$branch")"
    pending_rewrite "$branch" "$remote" || fail "no recorded local rewrite for $branch"
    git merge-base --is-ancestor "$REWRITE_HEAD" HEAD ||
      fail "local branch diverged from recorded rewrite"
    publish_rewrite "$branch" "$remote" "$REWRITE_EXPECTED" ||
      fail "lease-safe rewrite push failed; local commits were preserved"
  else
    push_working_branch "$branch"
  fi

  printf '[git] push ok branch=%s pr=%s\n' "$branch" "$PR_SYNC_STATUS"
}

push_changes "$@"
